# Claude Code local overrides
.claude/settings.local.json

# Impeccable: config.json, design.json, and surfaces/ (direction contracts) are durable records,
# shared and committed. build/ (in-progress round bookkeeping) and review/ (verification
# screenshots) are ephemeral scratch output, regenerated per session -- never shared.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/build/
**/.impeccable/review/

# RepoWise index -- machine-local caches, vector store, and session databases.
# Regenerated by `repowise init`; never shared between machines.
.repowise/
