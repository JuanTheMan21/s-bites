# Frontend build-time configuration. Copy to .env.local and fill in.
# These are baked into the bundle at build time -- Vite has no runtime env.

# The deployed backend's absolute origin in production; unset locally, where vite.config.ts
# proxies /api to 127.0.0.1:8000 instead.
VITE_API_BASE=

# --- Identity (T38A) ---------------------------------------------------------
# Leave VITE_ENTRA_CLIENT_ID empty to run with sign-in switched off entirely, against a backend
# with AUTH_ENV=none. That is a supported mode, not a broken one.
VITE_ENTRA_CLIENT_ID=

# The one value that decides who may sign in:
#   .../common       any Microsoft identity, personal or work
#   .../<tenant-id>  an ordinary single-tenant enterprise app -- only that directory
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common

# Must match the API's ENTRA_REQUIRED_SCOPE.
VITE_ENTRA_SCOPE=Jobs.ReadWrite
