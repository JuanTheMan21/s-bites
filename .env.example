# ---------------------------------------------------------------------------
# Which adapter set config.py resolves. The ONLY switch between local and cloud.
# ---------------------------------------------------------------------------
RUNTIME_ENV=azure

# --- Azure OpenAI / Foundry (RUNTIME_ENV=azure) ----------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Bounds LLM fan-out so parallel segments do not trip 429s. Match to deployment TPM.
AZURE_OPENAI_MAX_CONCURRENCY=4

# --- Azure AI Speech (RUNTIME_ENV=azure) -----------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# --- Azure Blob Storage (RUNTIME_ENV=azure) --------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=explainer-artifacts
AZURE_SKILLS_CONTAINER=runtime-skills

# --- Service Bus (RUNTIME_ENV=azure; stub only until T34, see decisionlog D25) ---
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=video-jobs

# --- Container Apps (RUNTIME_ENV=azure; stub only until T35, see decisionlog D25) -
AZURE_RESOURCE_GROUP=
AZURE_CONTAINER_APPS_ENVIRONMENT=

# --- Local adapters (RUNTIME_ENV=local) ------------------------------------
# Ollama and Kokoro are pushed out of T12 to a future iteration (Azure-focus decision, see
# decisionlog.md). These two are unused until that task lands; kept so RUNTIME_ENV=local's other
# adapters (job queue, render backend) don't have to renumber .env when it does.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
KOKORO_VOICE=af_heart
LOCAL_ARTIFACT_DIR=./artifacts
LOCAL_SKILLS_DIR=./runtime_skills

# --- Rendering --------------------------------------------------------------
# Measured in T4: ~1.7-2.7 frames/sec on a 16-core machine with 3 render workers.
# Frame count is the ONLY cost lever -- 720p measured slower than 1080p (see D17).
# FRAME_BUDGET 1400 @ 24fps buys two ~25s Tier-2 scenes = ~8-13 min of rendering. 600 was
# calibrated before anything multiplied a real measured duration by a frame rate (D32): against
# real narration, which runs a uniform ~25s a segment, it bought zero animation at all.
FPS=24
FRAME_BUDGET=1400
RENDER_MAX_CONCURRENCY=4
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
# hyperframes render --quality: draft (fast iteration) | standard | high (final delivery).
RENDER_QUALITY=standard
