# ---------------------------------------------------------------------------
# Which adapter set config.py resolves. The ONLY switch between local and cloud.
# ---------------------------------------------------------------------------
RUNTIME_ENV=azure

# --- Azure OpenAI / Foundry (RUNTIME_ENV=azure) ----------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Bounds LLM fan-out so parallel segments do not trip 429s. Match to deployment TPM.
AZURE_OPENAI_MAX_CONCURRENCY=4

# --- Azure AI Speech (RUNTIME_ENV=azure) -----------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# --- Azure Blob Storage (RUNTIME_ENV=azure) --------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=explainer-artifacts
AZURE_SKILLS_CONTAINER=runtime-skills

# --- Service Bus (RUNTIME_ENV=azure; stub only until T34, see decisionlog D25) ---
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=video-jobs

# --- Container Apps (RUNTIME_ENV=azure; stub only until T35, see decisionlog D25) -
AZURE_RESOURCE_GROUP=
AZURE_CONTAINER_APPS_ENVIRONMENT=

# --- Local adapters (RUNTIME_ENV=local) ------------------------------------
# Ollama and Kokoro are pushed out of T12 to a future iteration (Azure-focus decision, see
# decisionlog.md). These two are unused until that task lands; kept so RUNTIME_ENV=local's other
# adapters (job queue, render backend) don't have to renumber .env when it does.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
KOKORO_VOICE=af_heart
LOCAL_ARTIFACT_DIR=./artifacts
LOCAL_SKILLS_DIR=./runtime_skills

# --- Rendering --------------------------------------------------------------
# T18A corrected D16's throughput figure: 1.7-2.7 frames/sec was sampled on a 3-second render
# dominated by browser cold start, and this project's own successful renders already contradicted
# it. `npx hyperframes benchmark` on a real 25-second single-block segment measured ~17 frames/sec
# with --workers 4 at standard quality. Frame count is still the ONLY cost lever -- 720p measured
# slower than 1080p (see D17).
# T18B re-measured against a realistic composite scene (SPLIT_HORIZONTAL, two blocks, plus the
# scene-level camera drift every layout now carries): ~14.7-14.8 frames/sec, about 13% slower --
# more DOM/SVG per frame does cost something, but not enough to change FRAME_BUDGET (D105).
# scripts/measure_render_throughput.py reproduces this.
# FRAME_BUDGET 9500 @ 24fps funds Tier 2 on every segment the ladder allows (ASIDE-importance
# segments cap at Tier.REVEAL by design, not by budget -- see core/tier_resolver.py's IDEAL_TIER).
# A 7-minute/15-segment video needs ~9000 frames for full coverage; at ~14.75 frames/sec (T18B's
# composite-scene measurement, the more representative figure now) that is roughly 10.7 minutes of
# rendering, still comfortably inside the ~15-20 minute target even with contention.
FPS=24
FRAME_BUDGET=9500
RENDER_MAX_CONCURRENCY=2
# hyperframes render --workers: an int pins a worker count, "auto" lets the CLI calibrate against
# the machine (it already accounts for low-memory mode). Kept at "auto" here rather than a fixed
# high number because RENDER_MAX_CONCURRENCY also runs multiple segments' renders in parallel --
# each spawning its own worker pool -- and this machine's available RAM is the tighter constraint
# than CPU (16 cores, but as little as ~2.4GB free alongside everything else running).
RENDER_WORKERS=auto
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
# hyperframes render --quality: draft (fast iteration) | standard | high (final delivery).
RENDER_QUALITY=standard

# --- Render backend bridge (T18A, closes D92 for real) ----------------------
# RENDER_ENV overrides which stack RenderBackend resolves against, defaulting to RUNTIME_ENV when
# unset. ContainerAppsRenderBackend is still T35's stub, so RUNTIME_ENV=azure alone cannot drive a
# render -- setting RENDER_ENV=local lets cli.py run a full job standalone (real Azure LLM/TTS
# paired with the real local render backend) with no manual adapter-mixing. Temporary: T35 removes
# the need for this rather than adding a third value to it.
RENDER_ENV=local

# --- API / frontend (T24) ---------------------------------------------------
# Comma-separated origins api/main.py allows CORS from. The Vite dev server's default port; add
# the deployed frontend origin alongside it in production, comma-separated.
WEB_ORIGINS=http://localhost:5173
