{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "azure": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "repowise": {
      "command": "repowise",
      "args": [
        "mcp",
        "C:/Users/juant/Desktop/s_bites",
        "--transport",
        "stdio"
      ],
      "description": "repowise: codebase intelligence \u2014 docs, graph, git signals, dead code, decisions"
    }
  }
}
